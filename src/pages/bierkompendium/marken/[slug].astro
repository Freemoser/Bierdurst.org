---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import beerBrands from '../../../../data/beer-brands.json';
import beerStyles from '../../../../data/beer-styles.json';

export function getStaticPaths() {
  return beerBrands.map((brand) => ({ params: { slug: brand.slug }, props: { brand } }));
}
const { brand } = Astro.props;
const style = beerStyles.find((item) => item.slug === brand.style)!;
const canonical = `https://bier-durst.de/bierkompendium/marken/${brand.slug}/`;
const formatHl = (value: number) => new Intl.NumberFormat('de-DE').format(value);
const schemas = [
  { '@context': 'https://schema.org', '@type': 'Brand', name: brand.name, url: canonical },
  { '@context': 'https://schema.org', '@type': 'Organization', name: brand.brewery, address: { '@type': 'PostalAddress', addressLocality: brand.city, addressRegion: brand.state, addressCountry: 'DE' } }
];
---
<BaseLayout title={`${brand.name}: Brauerei, Herkunft & Biersorte`} description={`${brand.name}: Brauerei, Herkunft, Standort und Biersorte im kompakten Markenprofil mit offiziellen Quellen.`} canonical={canonical} structuredData={schemas}>
  <main id="inhalt">
    <div class="page-width"><Breadcrumbs items={[{ href: '/', label: 'Startseite' }, { href: '/bierkompendium/', label: 'Bierkompendium' }, { href: canonical.replace('https://bier-durst.de', ''), label: brand.name }]} /></div>
    <header class="beer-profile-hero brand-profile-hero">
      <div><p class="eyebrow">Echte Biermarke · {brand.state}</p><h1>{brand.name}</h1><p>{brand.brewery} aus {brand.city}. Im Kompendium ist die Marke dem Hauptstil {style.name} zugeordnet.</p><div class="profile-tags"><span>{style.name}</span><span>{style.fermentation}</span><span>{brand.group}</span></div></div>
      <div class="profile-scorecard brand-scorecard"><p>Markenprofil</p><span><small>Brauerei</small><b>{brand.brewery}</b></span><span><small>Standort</small><b>{brand.city}</b></span><span><small>Bundesland</small><b>{brand.state}</b></span>{brand.founded && <span><small>Gegründet</small><b>{brand.founded}</b></span>}</div>
    </header>
    <div class="beer-profile-layout">
      <article>
        <section><p class="eyebrow">Marke und Hersteller</p><h2>Steckbrief</h2><dl class="profile-facts"><div><dt>Marke</dt><dd>{brand.name}</dd></div><div><dt>Brauerei</dt><dd>{brand.brewery}</dd></div><div><dt>Gruppe</dt><dd>{brand.group}</dd></div><div><dt>Ort</dt><dd>{brand.city}</dd></div><div><dt>Bundesland</dt><dd>{brand.state}</dd></div><div><dt>Hauptstil</dt><dd><a href={`/bierkompendium/${style.slug}/`}>{style.name}</a></dd></div>{brand.founded && <div><dt>Gründungsjahr</dt><dd>{brand.founded}</dd></div>}</dl></section>

        {(brand.salesHl || brand.employees) && <section><p class="eyebrow">Veröffentlichte Kennzahlen</p><h2>Absatz und Beschäftigte</h2><div class="profile-stat-grid company-metrics">
          {brand.salesHl && <div><small>{brand.salesScope}</small><b>{formatHl(brand.salesHl)} hl</b><span>{brand.salesYear ? `Bezugsjahr ${brand.salesYear}` : brand.salesAsOf}</span></div>}
          {brand.employees && <div><small>Beschäftigte</small><b>{formatHl(brand.employees)}</b><span>Bezugsjahr {brand.employeesYear}</span></div>}
        </div><p class="metric-warning">Gruppenwerte gelten für das genannte Unternehmen und dürfen nicht als Absatz oder Beschäftigtenzahl einer einzelnen Produktvariante gelesen werden.</p></section>}

        <section><p class="eyebrow">Typische Werte des Hauptstils</p><h2>{style.name}</h2><p>{style.description} Die folgenden Spannen beschreiben den Bierstil; das konkrete Markenprodukt kann davon abweichen.</p><div class="profile-stat-grid"><div><small>Alkohol</small><b>{style.alcohol[0]}–{style.alcohol[1]} % vol.</b></div><div><small>Bitterkeit</small><b>{style.ibu[0]}–{style.ibu[1]} IBU</b></div><div><small>Farbe</small><b>{style.ebc[0]}–{style.ebc[1]} EBC</b></div><div><small>Stammwürze</small><b>{style.plato[0]}–{style.plato[1]} °P</b></div><div><small>Gärung</small><b>{style.fermentation}</b></div><div><small>Trinktemperatur</small><b>{style.temperature[0]}–{style.temperature[1]} °C</b></div></div></section>

        <section class="source-box"><h2>Herstellerquelle</h2><p>Markenname, Zuordnung und Standort wurden anhand des offiziellen Hersteller- oder Gruppenauftritts geprüft.</p><a href={brand.source} rel="noopener noreferrer">Offizielle Quelle öffnen →</a></section>
      </article>
      <aside class="profile-aside"><a class="button" href="/bierspiele/">Mit echten Marken spielen</a><a href="/bierkompendium/">← Zurück zum Kompendium</a></aside>
    </div>
  </main>
</BaseLayout>
