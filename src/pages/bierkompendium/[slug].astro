---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import beerStyles from '../../../data/beer-styles.json';

export function getStaticPaths() {
  return beerStyles.map((beer) => ({ params: { slug: beer.slug }, props: { beer } }));
}
const { beer } = Astro.props;
const canonical = `https://bier-durst.de/bierkompendium/${beer.slug}/`;
const midpoint = (range: number[]) => Math.round(((range[0] + range[1]) / 2) * 10) / 10;
const schemas = [{ '@context': 'https://schema.org', '@type': 'DefinedTerm', name: beer.name, description: beer.description, inDefinedTermSet: 'https://bier-durst.de/bierkompendium/', url: canonical }];
---
<BaseLayout title={`${beer.name}: Geschmack, Werte & Herkunft`} description={`${beer.name} im Bierkompendium: typische Werte für Alkohol, IBU, EBC und Stammwürze sowie Geschmack, Gärung, Herkunft und passende Speisen.`} canonical={canonical} structuredData={schemas}>
  <main id="inhalt">
    <div class="page-width"><Breadcrumbs items={[{ href: '/', label: 'Startseite' }, { href: '/bierkompendium/', label: 'Bierkompendium' }, { href: `/bierkompendium/${beer.slug}/`, label: beer.name }]} /></div>
    <header class="beer-profile-hero">
      <div><p class="eyebrow">{beer.family} · {beer.fermentation}</p><h1>{beer.name}</h1><p>{beer.description}</p><div class="profile-tags">{beer.profile.map((item: string) => <span>{item}</span>)}</div></div>
      <div class="profile-scorecard"><p>Quartett-Werte</p><span><small>Alkohol-Mitte</small><b>{midpoint(beer.alcohol)} %</b></span><span><small>IBU-Mitte</small><b>{midpoint(beer.ibu)}</b></span><span><small>EBC-Mitte</small><b>{midpoint(beer.ebc)}</b></span><span><small>Stammwürze-Mitte</small><b>{midpoint(beer.plato)} °P</b></span></div>
    </header>
    <div class="beer-profile-layout">
      <article>
        <section><p class="eyebrow">Typische Stilspanne</p><h2>Die wichtigsten Werte</h2><div class="profile-stat-grid">
          <div><small>Alkohol</small><b>{beer.alcohol[0]}–{beer.alcohol[1]} % vol.</b></div><div><small>Bitterkeit</small><b>{beer.ibu[0]}–{beer.ibu[1]} IBU</b></div><div><small>Farbe</small><b>{beer.ebc[0]}–{beer.ebc[1]} EBC</b></div><div><small>Stammwürze</small><b>{beer.plato[0]}–{beer.plato[1]} °P</b></div><div><small>Trinktemperatur</small><b>{beer.temperature[0]}–{beer.temperature[1]} °C</b></div><div><small>Verbreitung</small><b>{beer.availability}</b></div>
        </div></section>
        <section><h2>Charakter und Herkunft</h2><dl class="profile-facts"><div><dt>Gärung</dt><dd>{beer.fermentation}</dd></div><div><dt>Ursprung</dt><dd>{beer.origin}</dd></div><div><dt>Region</dt><dd>{beer.region}</dd></div><div><dt>Typisches Glas</dt><dd>{beer.glass}</dd></div></dl></section>
        <section><h2>Was passt dazu?</h2><div class="food-tags">{beer.food.map((item: string) => <span>{item}</span>)}</div></section>
        <section class="company-data-note"><h2>Verkaufszahlen und Mitarbeiter</h2><p>Diese Werte gehören nicht zum Bierstil, sondern zur jeweiligen Brauerei oder Marke. Im <a href="/bierkompendium/">Markenregister</a> zeigen wir veröffentlichte Absatz- und Beschäftigtenzahlen deshalb direkt auf den zugehörigen Markenkarten – immer mit Bezugsjahr und Herstellerquelle.</p></section>
        <section class="source-box"><h2>Datengrundlage</h2><p>Die Spannen beschreiben den Stil und können bei einzelnen Produkten abweichen.</p><a href={beer.source} rel="noopener noreferrer">Verwendete Stilquelle öffnen →</a></section>
      </article>
      <aside class="profile-aside"><a class="button" href="/bierspiele/">Mit diesem Datenbestand spielen</a><a href="/bierkompendium/">← Zurück zum Kompendium</a></aside>
    </div>
  </main>
</BaseLayout>
