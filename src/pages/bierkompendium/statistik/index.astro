---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ExperienceHero from '../../../components/ExperienceHero.astro';
import stats from '../../../../data/beer-market-statistics.json';
const schemas = [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Bierstatistik Deutschland', url: 'https://bier-durst.de/bierkompendium/statistik/', description: 'Zeitreihen und Quellen zu Bierabsatz, Braustätten, Beschäftigten, Biermarken und Biersorten in Deutschland.' }];
---
<BaseLayout title="Bierstatistik Deutschland: Absatz, Brauereien & Marken" description="Aktuelle Bierstatistiken für Deutschland: Bierabsatz, Braustätten, Beschäftigte, Biermarken und Biersorten mit Zeitreihen, Methodik und Primärquellen." canonical="https://bier-durst.de/bierkompendium/statistik/" structuredData={schemas}>
  <main id="inhalt">
    <div class="page-width"><Breadcrumbs items={[{ href: '/', label: 'Startseite' }, { href: '/bierkompendium/', label: 'Bierkompendium' }, { href: '/bierkompendium/statistik/', label: 'Statistik' }]} /></div>
    <ExperienceHero eyebrow="Daten · Zeitreihen · Primärquellen" title="Bierstatistik Deutschland" description="Wie entwickelt sich der deutsche Biermarkt? Hier findest du jede Kennzahl einzeln erklärt, mit vergleichbaren Jahreswerten und nachvollziehbaren Quellen." />
    <div class="statistics-wrap">
      <section class="statistics-lead"><p class="eyebrow">Stand: 4. August 2026</p><h2>Fünf Kennzahlen, sauber getrennt</h2><p>Marken, Sorten, Braustätten, Absatz und Beschäftigte beschreiben unterschiedliche Dinge. Jede Statistikseite erläutert deshalb zuerst die Definition und zeigt nur Zeitverläufe, für die vergleichbare Jahreswerte vorliegen.</p></section>
      <div class="statistics-grid">
        {stats.map((stat, index) => <a class="statistics-card" href={`/bierkompendium/statistik/${stat.slug}/`}>
          <span>0{index + 1} · Statistik</span><strong>{stat.value}</strong><h2>{stat.shortLabel}</h2><p>{stat.summary}</p><b>Gesamte Statistik ansehen →</b>
        </a>)}
      </div>
      <section class="method-note"><h2>Unsere Datenregel</h2><p>Wir bevorzugen Destatis, die amtliche GENESIS-Datenbank und zusammenfassende Veröffentlichungen des Deutschen Brauer-Bundes. Bei revidierten Werten gilt die jüngste Veröffentlichung. Schätzungen werden nicht mit amtlichen Zählungen vermischt und fehlende historische Daten nicht ergänzt.</p></section>
    </div>
  </main>
</BaseLayout>
