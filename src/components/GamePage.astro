---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ExperienceHero from './ExperienceHero.astro';
import BeerGame from './BeerGame.astro';

const { mode, title, description, intro } = Astro.props as { mode: 'blind' | 'tier' | 'swipe'; title: string; description: string; intro: string };
const canonical = `https://bier-durst.de/bierspiele/${mode === 'blind' ? 'blind-ranking' : mode === 'tier' ? 'tier-list' : 'hit-oder-shit'}/`;
const breadcrumbs = [{ href: '/', label: 'Startseite' }, { href: '/bierspiele/', label: 'Bierspiele' }, { href: canonical.replace('https://bier-durst.de', ''), label: title }];
---
<BaseLayout title={`${title} | Bier-Durst.de`} description={description} canonical={canonical}>
  <main id="inhalt">
    <div class="page-width"><Breadcrumbs items={breadcrumbs} /></div>
    <ExperienceHero eyebrow="Bierspiele" title={title} description={description} />
    <section class="experience-wrap">
      <p class="experience-intro">{intro}</p>
      <BeerGame mode={mode} />
      <p class="privacy-note">Dein Spielstand bleibt auf diesem Gerät. Es werden keine Bewertungen an uns übertragen und keine Community-Rangliste erzeugt.</p>
    </section>
  </main>
</BaseLayout>
