---
const { sources = [] } = Astro.props as { sources?: string[] };
const label = (source: string) => {
  try {
    const url = new URL(source);
    const host = url.hostname.replace(/^www\./, '');
    const parts = url.pathname.split('/').filter(Boolean);
    if (parts.length === 0) return `${host} – Startseite`;

    const page = parts.at(-1)!
      .replace(/[-_]+/g, ' ')
      .replace(/\b\w/g, (character) => character.toUpperCase());
    return `${host} – ${page}`;
  } catch {
    return source;
  }
};
const uniqueSources = [...new Set(sources)];
---
{uniqueSources.length > 0 && <section class="sources" aria-labelledby="sources-heading"><h2 id="sources-heading">Quellen und Einordnung</h2><p>Die Inhalte stützen sich auf die folgenden Ausgangsquellen. Abruf und redaktionelle Einordnung entsprechen dem angegebenen Aktualisierungsstand.</p><ul>{uniqueSources.map((source) => <li><a href={source} rel="noopener noreferrer">{label(source)}</a></li>)}</ul></section>}
