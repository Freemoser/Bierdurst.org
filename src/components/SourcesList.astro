---
const { sources = [] } = Astro.props as { sources?: string[] };
const label = (source: string) => {
  try { return new URL(source).hostname.replace(/^www\./, ''); } catch { return source; }
};
---
{sources.length > 0 && <section class="sources" aria-labelledby="sources-heading"><h2 id="sources-heading">Quellen und Einordnung</h2><p>Die Inhalte stützen sich auf die folgenden Ausgangsquellen. Abruf und redaktionelle Einordnung entsprechen dem angegebenen Aktualisierungsstand.</p><ul>{sources.map((source) => <li><a href={source} rel="noopener noreferrer">{label(source)}</a></li>)}</ul></section>}
