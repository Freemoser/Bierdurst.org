---
interface Item { href: string; label: string }
const { items } = Astro.props as { items: Item[] };
---
<nav class="breadcrumbs" aria-label="Brotkrumen">
  <ol>
    {items.map((item, index) => <li>{index < items.length - 1 ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</li>)}
  </ol>
</nav>
