---
const { eyebrow, title, description } = Astro.props as { eyebrow: string; title: string; description: string };
---
<header class="page-hero experience-hero">
  <div class="hero-copy">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
  <div class="game-symbols" aria-hidden="true"><span>1–10</span><span>S</span><span>♥</span></div>
</header>
